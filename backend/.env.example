# Biến môi trường BACKEND — copy thành backend/.env rồi điền giá trị thật.
# backend/.env đã nằm trong .gitignore: KHÔNG commit, KHÔNG gửi lên chat/nhóm công khai.
# Khi deploy: khai báo các biến này trong environment manager của nền tảng (không dùng file).

# --- Database (ADR-ARCH-003: Supabase làm nơi chạy PostgreSQL, FastAPI là lớp duy nhất đọc/ghi) ---
# Lấy ở Supabase Dashboard → Connect → "Session pooler" → URI, thay [YOUR-PASSWORD] bằng mật khẩu DB.
DATABASE_URL=postgresql://postgres.<project-ref>:[]@<pooler-host>:5432/postgres
# true CHỈ khi dùng PostgreSQL local trống (docker compose up -d db): tự tạo bảng + seed món mẫu.
AUTO_CREATE_SCHEMA=false
# true để bật nút demo "Đơn mới" trên KDS (POST /kds/demo/orders). Tắt khi deploy thật.
DEMO_MODE=false

# --- Supabase server-side (SECRET — chỉ ở backend, tuyệt đối không đưa vào frontend) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# --- Khác ---
# Mức log của backend (DEBUG | INFO | WARNING | ERROR). Không bao giờ ghi secret/PIN/ghi chú khách.
LOG_LEVEL=INFO
JWT_SECRET=change-me
AI_API_KEY=
