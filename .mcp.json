{
  "mcpServers": {
    "taiga-mcp": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@elio9352/taiga-mcp-server"],
      "env": {
        "TAIGA_API_URL": "https://api.taiga.io/api/v1",
        "TAIGA_USERNAME": "${TAIGA_USERNAME}",
        "TAIGA_PASSWORD": "${TAIGA_PASSWORD}"
      }
    },
    "figma-mcp": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "figma-developer-mcp", "--stdio"],
      "env": {
        "FIGMA_API_KEY": "${FIGMA_API_KEY}"
      }
    }
  }
}
